{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "mobspawncontroller.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mobspawncontroller.fabric.MobSpawnControllerFabric"
    ],
    "client": [
      "com.mobspawncontroller.fabric.MobSpawnControllerFabricClient"
    ]
  },
  "mixins": [
    "mobspawncontroller.mixins.json",
    "mobspawncontroller.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "sereneseasons": "*"
  }
}
